# Copia este archivo a envs/.env y llena los valores privados.
# envs/.env NO se commitea (gitignore); todo lo de aqui son credenciales.
# Los application-dev.yml leen estas variables con ${VAR:default}.

# TMDB: token de lectura (v3/v4) para el enriquecimiento del catalogo.
TMDB_API_TOKEN=

# Credenciales de servicios si no quieres los defaults de dev:
#MINIO_ACCESS_KEY=admin
#MINIO_SECRET_KEY=admin123
#MINIO_WEBHOOK_TOKEN=dev-webhook-secret

# Secretos de clientes OAuth2 (defaults de dev):
#OAUTH2_CLIENT_SECRET=super-secret